# ============================================================================
# DSH Video Workbench - Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your local machine paths.
# DO NOT commit `.env` to Git.
# ============================================================================

# --- 1. DeepSeek Harness (DSH) Runtime Paths ---
# Path to DeepSeek Harness Desktop `app` directory (optional if `dsh` is on PATH)
DSH_APP_ROOT=
# Optional custom DSH_HOME directory for isolated profile state
DSH_VIDEO_HOME=
# Default workspace root where video projects are stored
DSH_VIDEO_WORKSPACE=./examples

# macOS note: Node.js >= 20 (brew install node), FFmpeg (brew install ffmpeg),
# and the built-in `say` command are all you need for a zero-GPU setup.
# Launch with: bash start-workbench.sh   (or: pnpm start:mac)

# --- 2. FFmpeg & Media Probing ---
# Path to ffmpeg and ffprobe executables (falls back to system PATH if empty)
# macOS: Homebrew ffmpeg (/opt/homebrew/bin/ffmpeg) is auto-preferred over older
#        static builds that can hang on complex filter chains. Set an absolute
#        FFMPEG_PATH here to override that choice.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- 3. Local TTS Engines (IndexTTS-2.5 & GPTvoice-tts / GPT-SoVITS) ---
# Preferred engine: indextts25 | indextts2 | gptvoice | auto
# Zero-GPU built-in fallback (chosen automatically when no local model is configured):
#   macOS   -> macos-say-cpu   (built-in `say`, e.g. Tingting / Meijia)
#   Windows -> windows-sapi-cpu (System.Speech)
#   Linux   -> linux-espeak-cpu (needs: sudo apt install espeak-ng)
DEFAULT_TTS_ENGINE=indextts25

# IndexTTS-2.5 (recommended, https://github.com/index-tts/index-tts) or legacy IndexTTS-2 HTTP Endpoint & Local Root
INDEXTTS_ENDPOINT=http://127.0.0.1:9880
INDEXTTS_WEBUI_ENDPOINT=http://127.0.0.1:7860
INDEXTTS_ROOT=
INDEXTTS_PYTHON=
INDEXTTS_QWEN_EMO=1

# macOS built-in `say` voice (optional; defaults to Tingting / 婷婷).
# Run `say -v '?'` to list voices. Chinese options: Tingting, Meijia, Shelley, Eddy (note: no hyphens).
MACOS_SAY_VOICE=Tingting

# Linux espeak-ng binary (optional; defaults to espeak-ng).
ESPEAK_BIN=espeak-ng

# GPTvoice-tts (GPT-SoVITS) HTTP Endpoint & Local Installation Root
GPTVOICE_ENDPOINT=http://127.0.0.1:9881
GPTVOICE_ROOT=
GPTVOICE_PYTHON=
GPTVOICE_SHARED_PYLIBS=
GPTVOICE_CONFIG=GPT_SoVITS/configs/tts_infer.yaml

# --- 4. Voice Pack Catalog & Default Reference Audio ---
# Directory storing voice pack catalog and imported voice packs
VOICE_PACKS_DIR=./voice-packs
# Optional extra directories to scan for existing voice references (semicolon-separated on Windows)
EXTRA_VOICE_SCAN_DIRS=
# Optional default fallback reference WAV and prompt text
DEFAULT_REF_AUDIO=
DEFAULT_REF_TEXT=

# --- 5. Dual-Engine Video Rendering (HTML/GSAP & Remotion) ---
# Existing local Remotion project directory providing @remotion/bundler & @remotion/renderer
REMOTION_TEMPLATE_ROOT=
# Playwright Chromium browsers cache directory (for HTML frame-accurate snapshot & render)
PLAYWRIGHT_BROWSERS_PATH=
# Optional path to Chromium / Chrome / Edge binary for HTML snapshot & rendering
BROWSER_EXECUTABLE_PATH=

# --- 6. Model-Agnostic LLM Coding Studio ---
# Mode: follow-dsh (default: follows active DSH client provider/model/key) | custom (explicit plugin fields)
# Wire protocols supported: auto | openai-completions | anthropic-messages | openai-responses | gemini-native
LLM_MODE=follow-dsh
LLM_PROVIDER=
LLM_FORMAT=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_REPAIR_ROUNDS=3

# --- 7. Pluggable AI & Cloned Digital Human Avatar (`dsh-tool-avatar`) ---
# Provider: auto | musetalk | latentsync | external-http | local-composite
AVATAR_PROVIDER=auto
# Local MuseTalk / LatentSync Gradio or REST server, or remote API URL (optional)
AVATAR_ENDPOINT=
# Optional Bearer API key for external digital human provider (never commit secrets)
AVATAR_API_KEY=
AVATAR_TIMEOUT_MS=180000


